#!/usr/bin/env bash
set -Eeuo pipefail
[[ $EUID -eq 0 ]] || { echo 'must run as root' >&2; exit 1; }
(( $# == 8 && $1 == build )) || { echo 'usage: stepanel-runnerctl build SITE IMAGE ROOT SCRIPT CPU_PERCENT MEMORY_MB TASKS_MAX' >&2; exit 64; }
site=$2 image=$3 root=$4 script=$5 cpu_percent=$6 memory_mb=$7 tasks_max=$8
[[ $site =~ ^[a-z0-9_-]{1,32}$ && $image =~ ^[a-z0-9][a-z0-9._/-]{0,180}(:[A-Za-z0-9._-]{1,80})?$ && $cpu_percent =~ ^[0-9]+$ && $memory_mb =~ ^[0-9]+$ && $tasks_max =~ ^[0-9]+$ && $cpu_percent -ge 25 && $cpu_percent -le 6400 && $memory_mb -ge 64 && $memory_mb -le 1048576 && $tasks_max -ge 16 && $tasks_max -le 100000 && ( $root == "/var/www/sites/$site/public" || $root =~ ^/var/www/sites/$site/\.stepanel-release-[A-Za-z0-9-]+$ ) ]] || { echo 'invalid build request' >&2; exit 1; }
[[ -d $root && ! -L $root && -f $script && ! -L $script && -d "/var/www/sites/$site" && ! -L "/var/www/sites/$site" ]] || { echo 'invalid build inputs' >&2; exit 1; }
command -v podman >/dev/null || { echo 'rootless Podman is required' >&2; exit 1; }
hash=$(printf '%s' "$site" | sha256sum); hash=${hash%% *}; prefix=${site:0:18}; prefix=${prefix//_/-}; site_user="sp-${prefix}-${hash:0:8}"
id "$site_user" >/dev/null 2>&1 || { echo 'site user is unavailable' >&2; exit 1; }
artifact="/var/www/sites/$site/.stepanel-artifact"
rm -rf -- "$artifact"
install -d -m 0750 -o "$site_user" -g "$site_user" "$artifact"
cpus=$(awk "BEGIN { printf \"%.2f\", $cpu_percent / 100 }")
runuser -u "$site_user" -- podman run --rm --network slirp4netns --userns keep-id --cap-drop ALL --security-opt no-new-privileges --read-only --cpus "$cpus" --memory "${memory_mb}m" --pids-limit "$tasks_max" --tmpfs /tmp:rw,noexec,nosuid,size=512m -v "$root:/src:ro,Z" -v "$artifact:/artifact:rw,Z" -v "$script:/run/stepanel/build.sh:ro,Z" -w /src "$image" /bin/sh /run/stepanel/build.sh
