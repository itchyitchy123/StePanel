#!/usr/bin/env bash
set -Eeuo pipefail
[[ $EUID -eq 0 ]] || { echo 'must run as root' >&2; exit 1; }

root=/usr/local/lsws/conf/vhosts/stepanel/proxy
lswsctrl=${LSWSCTRL:-/usr/local/lsws/bin/lswsctrl}
[[ -x "$lswsctrl" ]] || lswsctrl=$(command -v lswsctrl || true)
[[ -x "$lswsctrl" ]] || { echo 'OpenLiteSpeed control command not found' >&2; exit 1; }
install -d -m 0755 -o root -g root "$root"
exec 9>/run/lock/stepanel-ols.lock
flock -x 9

valid_backend() {
  local backend=$1 host port first second third fourth
  port=${backend##*:}
  host=${backend%:*}
  [[ $port =~ ^[0-9]{1,5}$ ]] && (( port >= 1 && port <= 65535 )) || return 1
  [[ $host == localhost || $host == '[::1]' ]] && return 0
  [[ $host =~ ^\[([fF][cCdD][0-9A-Fa-f:]*|[fF][eE][89aAbB][0-9A-Fa-f:]*)\]$ ]] && return 0
  [[ $host =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
  IFS=. read -r first second third fourth <<< "$host"
  (( first <= 255 && second <= 255 && third <= 255 && fourth <= 255 )) || return 1
  (( first == 10 || first == 127 || first == 192 && second == 168 || first == 172 && second >= 16 && second <= 31 ))
}

restart() { "$lswsctrl" restart >/dev/null; }

case "${1:-}" in
  apply)
    (( $# == 4 )) || { echo 'usage: stepanel-ols-proxyctl apply SITE DOMAIN BACKEND' >&2; exit 64; }
    site=$2; domain=${3,,}; backend=$4
    [[ $site =~ ^[a-z0-9_-]{1,32}$ && $domain =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || { echo 'invalid site or domain' >&2; exit 1; }
    valid_backend "$backend" || { echo 'invalid backend' >&2; exit 1; }
    path="$root/${site}-${domain//./_}.conf"
    backup=''
    if [[ -f "$path" ]]; then backup=$(mktemp); cp -p "$path" "$backup"; fi
    tmp=$(mktemp "$root/.stepanel.XXXXXX")
    trap 'rm -f "$tmp" "$backup"' EXIT
    printf '# StePanel managed OpenLiteSpeed proxy for %s\nRewriteRule ^(.*)$ http://%s/$1 [P,L]\n' "$domain" "$backend" > "$tmp"
    chmod 0644 "$tmp"; chown root:root "$tmp"; mv -f "$tmp" "$path"
    if ! restart; then
      if [[ -n "$backup" ]]; then mv -f "$backup" "$path"; else rm -f "$path"; fi
      restart || true
      exit 1
    fi
    ;;
  delete)
    (( $# == 2 )) || { echo 'usage: stepanel-ols-proxyctl delete NAME' >&2; exit 64; }
    [[ $2 =~ ^[a-z0-9_-]{1,32}-[a-z0-9_-]+\.conf$ ]] || { echo 'invalid proxy name' >&2; exit 1; }
    path="$root/$2"; [[ -f "$path" ]] || { echo 'proxy not found' >&2; exit 1; }
    backup=$(mktemp); cp -p "$path" "$backup"; rm -f "$path"
    if ! restart; then mv -f "$backup" "$path"; restart || true; exit 1; fi
    rm -f "$backup"
    ;;
  *) echo 'usage: stepanel-ols-proxyctl apply SITE DOMAIN BACKEND | delete NAME' >&2; exit 64 ;;
esac
