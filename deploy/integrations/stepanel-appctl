#!/usr/bin/env bash
set -Eeuo pipefail
if [[ $EUID -ne 0 ]]; then echo 'must run as root' >&2; exit 1; fi
action=${1:-}; site=${2:-}
[[ $site =~ ^[a-z0-9_-]{1,32}$ ]] || { echo 'invalid site' >&2; exit 1; }
command -v flock >/dev/null 2>&1 || { echo 'flock is required for application lifecycle locking' >&2; exit 1; }
exec 9>/run/lock/stepanel-app.lock
flock -x 9
unit="stepanel-app-${site}.service"
hash=$(printf '%s' "$site" | sha256sum); hash=${hash%% *}
prefix=${site:0:18}; prefix=${prefix//_/-}
site_user="sp-${prefix}-${hash:0:8}"
id "$site_user" >/dev/null 2>&1 || { echo 'isolated site user does not exist' >&2; exit 1; }
case "$action" in
  apply)
    (( $# == 5 )) || { echo 'usage: stepanel-appctl apply SITE VERSION ROOT PORT' >&2; exit 64; }
    version=${3:?missing Node version}; root=${4:?missing root}; port=${5:?missing port}
    [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $port =~ ^[0-9]+$ ]] || { echo 'invalid app parameters' >&2; exit 1; }
    (( port >= 1024 && port <= 65535 )) || { echo 'invalid app port' >&2; exit 1; }
    [[ $root == "/var/www/sites/$site/public" ]] || { echo 'invalid app root' >&2; exit 1; }
    path="/etc/systemd/system/$unit"
    staged=$(mktemp "/etc/systemd/system/.stepanel-app.XXXXXX")
    backup=$(mktemp)
    existed=0
    was_active=0
    if [[ -f $path ]]; then cp -p "$path" "$backup"; existed=1; fi
    if systemctl is-active --quiet "$unit"; then was_active=1; fi
    cleanup() { rm -f "$staged" "$backup"; }
    rollback() {
      if (( existed )); then mv -f "$backup" "$path"; else rm -f "$path"; fi
      systemctl daemon-reload || true
      if (( existed && was_active )); then
        systemctl restart "$unit" || true
      else
        systemctl stop "$unit" || true
      fi
      if (( ! existed )); then systemctl disable "$unit" || true; fi
    }
    trap cleanup EXIT
    cat > "$staged" <<EOF
[Unit]
Description=StePanel Node app $site
After=network-online.target

[Service]
User=$site_user
Group=$site_user
WorkingDirectory=$root
Environment=PORT=$port NODE_ENV=production HOME=/var/www/sites/$site
ExecStart=/bin/bash -lc 'export NVM_DIR=/opt/stepanel/.nvm; . "\$NVM_DIR/nvm.sh"; nvm use $version >/dev/null; exec npm start'
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0027
LimitNOFILE=65536
TasksMax=256
ReadWritePaths=$root

[Install]
WantedBy=multi-user.target
EOF
    chmod 0644 "$staged"
    chown root:root "$staged"
    mv -f "$staged" "$path"
    if ! systemctl daemon-reload || ! systemctl enable --now "$unit"; then
      rollback
      exit 1
    fi
    ;;
  start|stop|restart)
    (( $# == 2 )) || { echo "usage: stepanel-appctl $action SITE" >&2; exit 64; }
    systemctl "$action" "$unit" ;;
  *) echo 'usage: stepanel-appctl apply|start|stop|restart SITE ...' >&2; exit 64 ;;
esac
