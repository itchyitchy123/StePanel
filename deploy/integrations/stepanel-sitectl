#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $EUID -ne 0 ]]; then echo 'must run as root' >&2; exit 1; fi
(( $# == 2 || $# == 3 || $# == 4 || $# == 11 )) || { echo 'usage: stepanel-sitectl prepare|seal SITE | resources SITE PHP_WORKERS | quota SITE DISK_MB INODES | quota-clear SITE | runtime SITE VERSION MEMORY EXEC UPLOAD POST INPUT OPCACHE DISPLAY ERROR' >&2; exit 64; }

action=$1
site=$2
[[ $site =~ ^[a-z0-9_-]{1,32}$ ]] || { echo 'invalid site' >&2; exit 1; }
[[ $action == prepare || $action == seal || $action == runtime || $action == resources || $action == quota || $action == quota-clear ]] || { echo 'invalid action' >&2; exit 64; }

if getent group www-data >/dev/null; then
  web_group=www-data
  socket_root=/run/php
elif getent group apache >/dev/null; then
  web_group=apache
  socket_root=/run/php-fpm
else
  echo 'Apache group was not found' >&2
  exit 1
fi

hash=$(printf '%s' "$site" | sha256sum)
hash=${hash%% *}
prefix=${site:0:18}
prefix=${prefix//_/-}
site_user="sp-${prefix}-${hash:0:8}"
site_root="/var/www/sites/$site"
public_root="$site_root/public"
php_state="$site_root/.php"

if ! id "$site_user" >/dev/null 2>&1; then
  useradd --system --home-dir "$site_root" --shell /usr/sbin/nologin --user-group "$site_user"
fi
install -d -m 2750 -o "$site_user" -g "$web_group" "$site_root" "$public_root"
install -d -m 0750 -o "$site_user" -g "$web_group" "$php_state" "$php_state/sessions" "$php_state/tmp"

profile="$php_state/runtime.env"
php_version=""
memory_limit=128M
max_execution_time=60
upload_max_filesize=32M
post_max_size=32M
max_input_vars=1000
opcache_enabled=1
display_errors=0
error_reporting='E_ALL & ~E_DEPRECATED & ~E_STRICT'
if [[ $action == runtime ]]; then
  php_version=$3; memory_limit=$4; max_execution_time=$5; upload_max_filesize=$6; post_max_size=$7; max_input_vars=$8; opcache_enabled=$9; display_errors=${10}; error_reporting=${11}
  error_pattern='^[A-Z0-9_~& |]{1,80}$'
  [[ $php_version =~ ^[0-9]+\.[0-9]+$ && $memory_limit =~ ^[1-9][0-9]{0,4}M$ && $max_execution_time =~ ^[1-9][0-9]{0,4}$ && $upload_max_filesize =~ ^[1-9][0-9]{0,4}M$ && $post_max_size =~ ^[1-9][0-9]{0,4}M$ && $max_input_vars =~ ^[1-9][0-9]{0,6}$ && $opcache_enabled =~ ^[01]$ && $display_errors =~ ^[01]$ && $error_reporting =~ $error_pattern ]] || { echo 'invalid PHP runtime profile' >&2; exit 1; }
  tmp=$(mktemp "$php_state/.runtime.XXXXXX")
  printf 'php_version=%q\nmemory_limit=%q\nmax_execution_time=%q\nupload_max_filesize=%q\npost_max_size=%q\nmax_input_vars=%q\nopcache_enabled=%q\ndisplay_errors=%q\nerror_reporting=%q\n' "$php_version" "$memory_limit" "$max_execution_time" "$upload_max_filesize" "$post_max_size" "$max_input_vars" "$opcache_enabled" "$display_errors" "$error_reporting" > "$tmp"
  chown root:root "$tmp"; chmod 0600 "$tmp"; mv -f "$tmp" "$profile"
  action=seal
elif [[ $action == resources ]]; then
  workers=$3
  [[ $workers =~ ^[0-9]+$ ]] && (( workers >= 1 && workers <= 512 )) || { echo 'invalid PHP worker limit' >&2; exit 1; }
  tmp=$(mktemp "$php_state/.resources.XXXXXX")
  printf 'php_max_children=%q\n' "$workers" > "$tmp"; chown root:root "$tmp"; chmod 0600 "$tmp"; mv -f "$tmp" "$php_state/resources.env"
  action=seal
elif [[ $action == quota ]]; then
  disk_mb=$3; inodes=$4
  [[ $disk_mb =~ ^[0-9]+$ && $inodes =~ ^[0-9]+$ ]] || { echo 'invalid filesystem quota' >&2; exit 1; }
  (( disk_mb >= 64 && disk_mb <= 1048576 && inodes >= 1000 && inodes <= 1000000000 )) || { echo 'filesystem quota out of range' >&2; exit 1; }
  command -v setquota >/dev/null 2>&1 || { echo 'setquota is required and filesystem quotas are not available' >&2; exit 1; }
  command -v findmnt >/dev/null 2>&1 || { echo 'findmnt is required for filesystem quota detection' >&2; exit 1; }
  mount=$(findmnt -no TARGET -T "$site_root") || { echo 'could not determine site filesystem mount' >&2; exit 1; }
  options=$(findmnt -no OPTIONS -T "$site_root") || { echo 'could not inspect site filesystem quota options' >&2; exit 1; }
  [[ $options =~ (^|,)(usrquota|uquota|usrjquota)(=|,|$) ]] || { echo 'site filesystem is not mounted with user quotas enabled' >&2; exit 1; }
  blocks=$(( (disk_mb * 1024 * 1024 + 1023) / 1024 ))
  setquota -u "$site_user" "$blocks" "$blocks" "$inodes" "$inodes" "$mount"
  printf 'filesystem_quota_applied\tmount=%s\tdisk_mb=%s\tinodes=%s\n' "$mount" "$disk_mb" "$inodes"
  exit 0
elif [[ $action == quota-clear ]]; then
  command -v setquota >/dev/null 2>&1 || { echo 'setquota is required and filesystem quotas are not available' >&2; exit 1; }
  command -v findmnt >/dev/null 2>&1 || { echo 'findmnt is required for filesystem quota detection' >&2; exit 1; }
  mount=$(findmnt -no TARGET -T "$site_root") || { echo 'could not determine site filesystem mount' >&2; exit 1; }
  options=$(findmnt -no OPTIONS -T "$site_root") || { echo 'could not inspect site filesystem quota options' >&2; exit 1; }
  [[ $options =~ (^|,)(usrquota|uquota|usrjquota)(=|,|$) ]] || { echo 'site filesystem is not mounted with user quotas enabled' >&2; exit 1; }
  setquota -u "$site_user" 0 0 0 0 "$mount"
  printf 'filesystem_quota_cleared\tmount=%s\n' "$mount"
  exit 0
elif [[ -f $profile && ! -L $profile ]]; then
  source "$profile"
fi
php_max_children=5
[[ ! -f $php_state/resources.env || -L $php_state/resources.env ]] || source "$php_state/resources.env"

command -v setfacl >/dev/null 2>&1 || { echo 'setfacl is required for site isolation' >&2; exit 1; }
setfacl -R -m u:stepanel:rwX "$site_root"
find "$site_root" -type d -exec setfacl -m d:u:stepanel:rwx {} +

if [[ $action == seal ]]; then
  chown -R "$site_user:$web_group" "$site_root"
  find "$site_root" -type d -exec chmod 2750 {} +
  setfacl -R -m u:stepanel:rwX "$site_root"
  find "$site_root" -type d -exec setfacl -m d:u:stepanel:rwx {} +
fi

pool_targets=()
pool_backups=()
pool_existed=()
pool_staged=()
validators=()
mapfile -t fpm_units < <(systemctl list-unit-files --type=service --no-legend 'php*-fpm.service' 'php-fpm.service' 2>/dev/null | awk '{print $1}')
(( ${#fpm_units[@]} > 0 )) || { echo 'PHP-FPM systemd unit was not found' >&2; exit 1; }

rollback_pools() {
  local index
  for (( index=${#pool_targets[@]}-1; index>=0; index-- )); do
    if [[ ${pool_existed[$index]} == 1 ]]; then
      mv -f "${pool_backups[$index]}" "${pool_targets[$index]}" || true
    else
      rm -f "${pool_targets[$index]}"
    fi
  done
}

cleanup_pool_temp() {
  local path
  for path in "${pool_backups[@]}" "${pool_staged[@]}"; do
    [[ -n $path ]] && rm -f "$path"
  done
}

pool_error() {
  local status=$?
  trap - ERR
  rollback_pools
  local unit
  for unit in "${fpm_units[@]}"; do systemctl reload-or-restart "$unit" 2>/dev/null || true; done
  cleanup_pool_temp
  exit "$status"
}
trap pool_error ERR

write_pool() {
  local target=$1 listen=$2 staged backup existed=0
  backup=$(mktemp)
  if [[ -e $target ]]; then cp -p "$target" "$backup"; existed=1; fi
  pool_targets+=("$target")
  pool_backups+=("$backup")
  pool_existed+=("$existed")
  staged=$(mktemp "${target}.XXXXXX")
  pool_staged+=("$staged")
  cat > "$staged" <<EOF
; Managed by StePanel. Manual changes will be replaced.
[stepanel-$site]
user = $site_user
group = $site_user
listen = $listen
listen.owner = $site_user
listen.group = $web_group
listen.mode = 0660
pm = ondemand
pm.max_children = $php_max_children
pm.process_idle_timeout = 10s
pm.max_requests = 500
chdir = /
catch_workers_output = yes
clear_env = yes
security.limit_extensions = .php
php_admin_value[open_basedir] = $public_root:$php_state
php_admin_value[session.save_path] = $php_state/sessions
php_admin_value[sys_temp_dir] = $php_state/tmp
php_admin_value[upload_tmp_dir] = $php_state/tmp
php_admin_value[memory_limit] = $memory_limit
php_admin_value[max_execution_time] = $max_execution_time
php_admin_value[upload_max_filesize] = $upload_max_filesize
php_admin_value[post_max_size] = $post_max_size
php_admin_value[max_input_vars] = $max_input_vars
php_admin_flag[opcache.enable] = $opcache_enabled
php_admin_flag[display_errors] = $display_errors
php_admin_value[error_reporting] = $error_reporting
EOF
  chmod 0644 "$staged"
  chown root:root "$staged"
  mv -f "$staged" "$target"
}

pool_written=0
for pool_root in /etc/php/*/fpm/pool.d; do
  [[ -d $pool_root ]] || continue
  version_root=$(dirname "$(dirname "$pool_root")")
  version=${version_root##*/}
  [[ -z $php_version || $version == "$php_version" ]] || continue
  validator=$(command -v "php-fpm$version") || { echo "php-fpm$version validator was not found" >&2; false; }
  validators+=("$validator")
  install -d -m 0755 "$socket_root"
  write_pool "$pool_root/stepanel-$site.conf" "$socket_root/stepanel-$site-$version.sock"
  pool_written=1
done
if [[ -d /etc/php-fpm.d ]]; then
  validator=$(command -v php-fpm) || { echo 'php-fpm validator was not found' >&2; false; }
  validators+=("$validator")
  install -d -m 0755 "$socket_root"
  write_pool "/etc/php-fpm.d/stepanel-$site.conf" "$socket_root/stepanel-$site.sock"
  pool_written=1
fi
if (( ! pool_written )); then
  echo 'PHP-FPM pool directory was not found' >&2
  exit 1
fi

for validator in "${validators[@]}"; do
  "$validator" -tt >/dev/null 2>&1 || { echo "$validator rejected the managed pool" >&2; false; }
done
for unit in "${fpm_units[@]}"; do systemctl reload-or-restart "$unit"; done
trap - ERR
cleanup_pool_temp

printf '%s\n' "$site_user"
